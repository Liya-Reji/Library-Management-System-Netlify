# Flask Configuration
FLASK_ENV=development
SECRET_KEY=generate-a-strong-random-secret-key-32-chars
PORT=5000
DEFAULT_LOAN_DAYS=14
SESSION_COOKIE_SECURE=false

# Database Connection URL
# For local SQLite development (default if unset):
# DATABASE_URL=sqlite:///instance/library.db
# For PostgreSQL (Docker / Render / Production):
DATABASE_URL=postgresql://postgres:postgres@db:5432/library_db

# Optional Demo Administrator Credentials (used only by scripts/seed_data.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@library.college.edu
ADMIN_PASSWORD=admin123
